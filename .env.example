# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the browser.

# Base URL for the API. Leave as /api to use a Vite dev proxy.
VITE_API_BASE_URL=/api

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Serve fixtures instead of calling the network — build UI without a backend.
VITE_API_USE_FIXTURES=true
